{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invoice-parser-to-r2",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "INVOICES_BUCKET",
      "bucket_name": "inbound-invoices"
    }
  ]
}
