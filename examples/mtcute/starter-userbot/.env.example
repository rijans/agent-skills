# Telegram API credentials from https://my.telegram.org
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Optional: set BOT_TOKEN if running as an official bot instead of a user account
# BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Optional: Base64 exported session string for stateless / container deployments
# SESSION_STRING=
